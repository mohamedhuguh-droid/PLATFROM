rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles & Subcollections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null; // Allows follower/following count updates and profile settings
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Saved / Bookmarked Posts
      match /saved_posts/{postId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Followers
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && (request.auth.uid == followerId || request.auth.uid == userId);
      }

      // Following
      match /following/{targetId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Blocked users
      match /blocked/{blockedId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Posts collection
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null; // Allows liking / quoting / comment count updates
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null;
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }
    
    // Status Notes
    match /notes/{noteId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.resource.data.userId == request.auth.uid || noteId == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || noteId == request.auth.uid);
    }
    
    // 1-on-1 Direct Chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      }
    }
    
    // Notifications
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.recipientId == request.auth.uid;
    }
    
    // Pinterest-Style Boards
    match /boards/{boardId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Instagram-Style Stories
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Communities
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // Live Consultations
    match /consultations/{consultId} {
      allow read: if request.auth != null && (
        resource.data.clientId == request.auth.uid || 
        resource.data.hostId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.clientId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.clientId == request.auth.uid || 
        resource.data.hostId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.clientId == request.auth.uid || 
        resource.data.hostId == request.auth.uid
      );
    }
  }
}
